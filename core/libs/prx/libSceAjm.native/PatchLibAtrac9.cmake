set(libatrac9OldPeek "\tconst int byteIndex = br->Position / 8;\n\tconst int bitIndex = br->Position % 8;\n\tconst int numBytes = (bitIndex + bits - 1) / 8 + 1;\n\tconst unsigned char* buffer = br->Buffer;\n\n\tint value;\n\tswitch (numBytes) {")
set(libatrac9NewPeek "\tconst int byteIndex = br->Position >> 3;\n\tconst int bitIndex = br->Position & 7;\n\tconst unsigned char* buffer = br->Buffer;\n\tif (bits <= 24 && byteIndex + 4 <= (br->LengthBits >> 3)) {\n\t\tuint32_t raw;\n\t\tmemcpy(&raw, buffer + byteIndex, 4);\n#if defined(__GNUC__) || defined(__clang__)\n\t\traw = __builtin_bswap32(raw);\n#elif defined(_MSC_VER)\n\t\traw = _byteswap_ulong(raw);\n#endif\n\t\traw <<= bitIndex;\n\t\treturn (int)(raw >> (32 - bits));\n\t}\n\tconst int numBytes = (bitIndex + bits - 1) / 8 + 1;\n\tint value;\n\tswitch (numBytes) {")
string(REPLACE "${libatrac9OldPeek}" "${libatrac9NewPeek}" libatrac9BitReader "${libatrac9BitReader}")
